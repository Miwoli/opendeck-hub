{
  "name": "com.miwoli.media",
  "version": "0.2.0",
  "private": true,
  "description": "OpenDeck plugin: now playing (MPRIS via busctl) with cover art, play/pause, next and switching between active players.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-icons.ts && node ../../scripts/build-plugin.mjs",
    "watch": "node ../../scripts/build-plugin.mjs --watch",
    "install-plugin": "npm run build && node ../../scripts/install-plugin.mjs",
    "pack": "npm run build && node ../../scripts/pack-plugin.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node ../../scripts/smoke-plugin.mjs",
    "test": "node ../../scripts/build-plugin.mjs && node --test 'test/**/*.test.ts' && node ../../scripts/smoke-plugin.mjs"
  },
  "dependencies": {
    "@miwoli/deck-core": "*",
    "ws": "^8.22.2"
  }
}
