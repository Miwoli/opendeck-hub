{
  "name": "com.miwoli.dev-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Developer plugin: shows every Nocturne tile state from @miwoli/deck-core on the real deck.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-icons.ts && node ../../scripts/build-plugin.mjs",
    "watch": "node ../../scripts/build-plugin.mjs --watch",
    "install-plugin": "npm run build && node ../../scripts/install-plugin.mjs",
    "pack": "npm run build && node ../../scripts/pack-plugin.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node ../../scripts/smoke-plugin.mjs",
    "test": "node ../../scripts/build-plugin.mjs && node ../../scripts/smoke-plugin.mjs"
  },
  "dependencies": {
    "@miwoli/deck-core": "*",
    "ws": "^8.18.0"
  }
}
