      "Icon": "images/actionHeadphones",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "images/keyHeadphones",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.miwoli.discord.ptt",
      "Name": "Push to talk",
      "Tooltip": "Microphone is live only while the key is held (Discord in voice-activity mode)",
